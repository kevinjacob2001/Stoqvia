MONGO_URI=mongodb://localhost:27017
MONGO_DB=retail_inventory_copilot
APP_NAME=Retail Inventory Copilot
APP_ENV=development
API_PREFIX=/api/v1
SEED_RANDOM_SEED=42
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORECAST_MODEL=lightgbm
AUTH_SECRET=stoqvia-dev-auth-secret
AUTO_COMPLETE_INTERVAL_SECONDS=30
# Optional testing override: supplier transit in minutes. 0 = use seed lead_days (calendar days).
SUPPLIER_LEAD_MINUTES=0
